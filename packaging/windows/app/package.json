{
  "name": "shadowstream-windows",
  "version": "2.4.47",
  "description": "ShadowStream desktop app for Windows",
  "main": "resources/app/main.js",
  "author": "ShadowStream",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac dmg zip"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.streamapp.app",
    "productName": "ShadowStream",
    "copyright": "ShadowStream",
    "directories": {
      "output": "dist-v2447",
      "buildResources": "build-res"
    },
    "files": [
      "resources/app/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ShadowStream-Setup-x64.${ext}",
      "sign": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.entertainment",
      "artifactName": "ShadowStream-macOS-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "generic",
      "url": "https://ssmoviestvs.site/downloads/"
    }
  }
}